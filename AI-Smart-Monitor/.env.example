# Smart Monitor — example environment (copy to .env)
# cp .env.example .env
ENVIRONMENT=development
APP_NAME=The Smart Monitor

# Primary store (docker-compose service name; local dev may use sqlite)
DATABASE_URL=postgresql+psycopg://smart_monitor:smart_monitor@postgres:5432/smart_monitor
REDIS_URL=redis://redis:6379/0

# Auth / sessions (task requires SECRET_KEY; app reads SESSION_SECRET)
SECRET_KEY=change-me-please-generate-strong-secret
SESSION_SECRET=change-me-please-generate-strong-secret
REQUIRE_API_KEY=false
API_KEY=
AUTH_MODE=legacy_api_key

CORS_ORIGINS=http://localhost:5173
AI_PROVIDER=mock
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ERP_BASE_URL=
ERP_API_KEY=
VITE_API_BASE_URL=http://localhost:8000/api/v1
