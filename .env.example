# Smart Monitor — example environment (copy to .env)
# cp .env.example .env
# NOTE: outer wrapper references the same values as AI-Smart-Monitor/.env.example
ENVIRONMENT=development
APP_NAME=The Smart Monitor
DATABASE_URL=postgresql+psycopg://smart_monitor:smart_monitor@postgres:5432/smart_monitor
REDIS_URL=redis://redis:6379/0
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
SECRET_KEY=change-me-please-generate-strong-secret
SESSION_SECRET=change-me-please-generate-strong-secret
SESSION_TTL_MINUTES=30
REQUIRE_API_KEY=false
API_KEY=
AUTH_MODE=legacy_api_key
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_BYTES=26214400
MAX_IMPORT_ROWS=100000
MAX_ERROR_DETAILS=500
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=30
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ERP_BASE_URL=
ERP_API_KEY=
ERP_TIMEOUT=20
ERP_MAX_ATTEMPTS=8
ERP_BASE_RETRY_SECONDS=30
ERP_CIRCUIT_FAILURE_THRESHOLD=5
ERP_CIRCUIT_COOLDOWN_SECONDS=300
RECONCILIATION_PAIRS=warehouse:branch,branch:cost,warehouse:cost,warehouse:erp,cost:erp,branch:erp
VITE_API_BASE_URL=http://localhost:8000/api/v1
